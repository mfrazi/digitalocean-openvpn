# EasyRSA vars - generated by Ansible
set_var EASYRSA_PKI             "{{ easyrsa_install_dir }}/pki"
set_var EASYRSA_DN              "cn_only"
set_var EASYRSA_REQ_COUNTRY     "US"
set_var EASYRSA_REQ_PROVINCE    "CA"
set_var EASYRSA_REQ_CITY        "San Francisco"
set_var EASYRSA_REQ_ORG         "OpenVPN"
set_var EASYRSA_REQ_EMAIL       "admin@example.com"
set_var EASYRSA_REQ_OU          "VPN"
set_var EASYRSA_KEY_SIZE        {{ openvpn_dh_keysize }}
set_var EASYRSA_ALGO            "rsa"
set_var EASYRSA_CA_EXPIRE       {{ openvpn_ca_expire }}
set_var EASYRSA_CERT_EXPIRE     {{ openvpn_cert_expire }}
set_var EASYRSA_CERT_RENEW      30
set_var EASYRSA_CRL_DAYS        {{ openvpn_crl_days }}
set_var EASYRSA_DIGEST          "sha256"
