# OpenVPN Server Configuration
# Generated by Ansible - do not edit manually
# Server: {{ openvpn_server_address }}

# Network settings
port {{ openvpn_port }}
proto {{ openvpn_proto }}
dev tun

# Certificates and keys
ca   {{ openvpn_server_dir }}/ca.crt
cert {{ openvpn_server_dir }}/server.crt
key  {{ openvpn_server_dir }}/server.key
dh   {{ openvpn_server_dir }}/dh.pem

# CRL (Certificate Revocation List)
crl-verify {{ openvpn_server_dir }}/crl.pem

# TLS security (tls-crypt provides authentication + encryption of control channel)
tls-crypt {{ openvpn_server_dir }}/ta.key

# VPN subnet
server {{ openvpn_server_network }} {{ openvpn_server_netmask }}

# Push routes to clients
{% if openvpn_redirect_gateway %}
push "redirect-gateway def1 bypass-dhcp"
{% endif %}

# Push DNS servers to clients
{% for dns in openvpn_dns_servers %}
push "dhcp-option DNS {{ dns }}"
{% endfor %}

# Keep-alive
keepalive {{ openvpn_keepalive_interval }} {{ openvpn_keepalive_timeout }}

# Cipher settings
cipher {{ openvpn_cipher }}
auth {{ openvpn_auth_digest }}
tls-version-min {{ openvpn_tls_version_min }}

# Restrict to strong TLS ciphers
tls-cipher TLS-ECDHE-RSA-WITH-AES-256-GCM-SHA384:TLS-ECDHE-ECDSA-WITH-AES-256-GCM-SHA384:TLS-DHE-RSA-WITH-AES-256-GCM-SHA384

# Drop privileges (not available in server mode with --daemon on some systems)
# user nobody
# group nogroup

# Persist state after restart
persist-key
persist-tun

# Log settings
status /var/log/openvpn-status.log
log-append /var/log/openvpn.log
verb {{ openvpn_verb }}
mute 20

# Maximum clients
max-clients {{ openvpn_max_clients }}

# Notify clients on server restart
explicit-exit-notify 1

# Client-to-client communication (optional, disable for isolation)
# client-to-client
