# Example Ansible inventory file
# This file is auto-generated by Terraform. Copy and edit manually if needed.
#
# Usage: Copy this to hosts.ini and update with your server's actual IP.
# cp ansible/inventory/hosts.ini.example ansible/inventory/hosts.ini

[openvpn_servers]
openvpn-server ansible_host=1.2.3.4 ansible_user=root ansible_ssh_private_key_file=~/.ssh/id_rsa ansible_ssh_common_args='-o StrictHostKeyChecking=no -o ConnectTimeout=30'

[openvpn_servers:vars]
ansible_python_interpreter=/usr/bin/python3
